{
  "hosting": {
    "public": ".",
    "ignore": [
      ".git/**",
      ".gitignore",
      ".firebase/**",
      ".firebaserc",
      "firebase.json",
      "firestore.rules",
      "**/node_modules/**",
      "**/*.md",
      "migrate.html",
      "firestore-crud.js"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true
    }
  }
}
